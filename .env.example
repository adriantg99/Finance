# Copia este archivo como ".env" y cambia los valores.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# Contraseña para entrar a la interfaz web.
# OBLIGATORIA en el servidor. En tu PC puedes dejarla vacía (solo se abre en 127.0.0.1).
FINANCE_PASSWORD=

# 127.0.0.1 = solo esta computadora. 0.0.0.0 = cualquier equipo de tu red (requiere contraseña).
# En el servidor déjalo en 127.0.0.1: nginx se encarga de recibir las visitas de internet.
HOST=127.0.0.1
PORT=5000

# Pon 1 solo si configuraste HTTPS (certbot). Hace que la cookie de sesión viaje solo por HTTPS.
COOKIE_SECURE=0
